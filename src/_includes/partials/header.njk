{%- set p1 = site.phones[0].display -%}
{%- set p2 = site.phones[1].display -%}
{#- 3.1 Шапка-плашка: зелёный блок внутри контейнера, прилегает к верху окна -#}
<header class="hdr" id="hdr">
  <div class="hdr__plate">

    <div class="hdr__info">
      <span class="hdr__city">{{ site.city }}</span>
      <span class="hdr__info-hide">{{ site.address.street }}</span>
      <span class="hdr__info-hide">{{ site.hours.short }}</span>
      <span class="hdr__info-right">
        <a href="{{ p1 | telHref }}" data-goal="phone_click">{{ p1 }}</a>
        <a href="{{ p2 | telHref }}" data-goal="phone_click">{{ p2 }}</a>
        <a class="hdr__msg" href="{{ site.telegram }}" target="_blank" rel="noopener" aria-label="Написать в Telegram">
          <svg class="i" aria-hidden="true"><use href="#i-telegram-logo"></use></svg></a>
      </span>
    </div>

    <div class="hdr__main">
      <a class="logo" href="/" aria-label="{{ site.name }}, на главную"><b>ГБО</b>-АВТО</a>

      <nav class="hdr__nav" aria-label="Основное меню">
        {%- for item in nav.header %}
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
        {%- endfor %}
      </nav>

      <div class="hdr__act">
        <a class="hdr__phone" href="{{ p1 | telHref }}" data-goal="phone_click">{{ p1 }}</a>
        <a class="hdr__cta" href="/kontakty/#zayavka">Записаться</a>
        <a class="hdr__call" href="{{ p1 | telHref }}" data-goal="phone_click" aria-label="Позвонить {{ p1 }}">
          <svg class="i" aria-hidden="true"><use href="#i-phone"></use></svg></a>
        <button class="burger" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="menu" data-menu-open>
          <svg class="i i--lg" aria-hidden="true"><use href="#i-list"></use></svg></button>
      </div>
    </div>

  </div>
</header>

<div class="menu" id="menu" hidden>
  <div class="menu__top"><div class="menu__top-in">
    <a class="logo" href="/"><b>ГБО</b>-АВТО</a>
    <button class="menu__close" type="button" aria-label="Закрыть меню" data-menu-close>
      <svg class="i i--lg" aria-hidden="true"><use href="#i-x"></use></svg></button>
  </div></div>
  <div class="menu__body">
    <nav class="menu__nav" aria-label="Меню сайта">
      {%- for item in nav.all %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>
        {{ item.title }}
        <svg class="i i--sm muted" aria-hidden="true"><use href="#i-caret-right"></use></svg>
      </a>
      {%- endfor %}
    </nav>
    <div class="menu__info flow flow-12">
      <a class="ftr__phone" style="color:var(--ink)" href="{{ p1 | telHref }}" data-goal="phone_click">{{ p1 }}</a>
      <a class="sm muted" style="display:block;text-decoration:none" href="{{ p2 | telHref }}" data-goal="phone_click">{{ p2 }}</a>
      <p class="cap">{{ site.address.street }}, {{ site.city }}<br>{{ site.hours.short }}</p>
      <div class="row" style="gap:10px">
        <a class="btn btn--outline btn--sm" href="{{ site.telegram }}" target="_blank" rel="noopener">
          <svg class="btn__i" aria-hidden="true"><use href="#i-telegram-logo"></use></svg>Telegram</a>
      </div>
      <a class="btn btn--primary btn--wide" href="/kontakty/#zayavka">Оставить заявку</a>
    </div>
  </div>
</div>

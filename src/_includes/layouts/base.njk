<!doctype html>
<html lang="ru" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.classList.remove('no-js')</script>

<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ page.url | absUrl }}">
{% if noindex %}<meta name="robots" content="noindex, nofollow">
{% else %}<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">{% endif %}
<meta name="theme-color" content="#007D3C">

<meta property="og:type" content="website">
<meta property="og:locale" content="ru_RU">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ page.url | absUrl }}">
{#- Ссылку на сервис пересылают в WhatsApp и Telegram: без обложки
    она разворачивается голым текстом. Собирается tools/build-og.py. -#}
<meta property="og:image" content="{{ '/assets/img/og-cover.jpg' | absUrl }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Установка ГБО в Златоусте — автосервис ГБО-АВТО">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ '/assets/img/og-cover.jpg' | absUrl }}">

<link rel="preload" href="/assets/fonts/golos-text-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/golos-text-700.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/styles.css">
<link rel="stylesheet" href="/assets/css/leads.css">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">

{#- Карточка организации. alternateName и description несут «автосервис»:
    по запросу «автосервис Златоуст» сайт иначе не опознаётся, а профиль
    у нас узкий — только газобаллонное оборудование, и так и написано.
    areaServed перечисляет города выезда поимённо (см. site.json). -#}
<script type="application/ld+json">{{ {
  "@context":"https://schema.org","@type":"AutoRepair","@id": site.url + "/#business",
  "name": site.name,
  "alternateName": "Автосервис ГБО-АВТО, Златоуст",
  "description": site.seoDescription,
  "url": site.url + "/",
  "image": site.url + "/assets/img/og-cover.jpg",
  "telephone": ["+79088196369","+79385178227"],
  "address": {"@type":"PostalAddress","streetAddress":site.address.street,
    "addressLocality":site.address.locality,"addressRegion":site.address.region,
    "postalCode":site.address.postalCode,"addressCountry":site.address.country},
  "geo": {"@type":"GeoCoordinates","latitude":site.address.lat,"longitude":site.address.lon},
  "hasMap": site.gis,
  "openingHours": site.hours.schemaOrg,
  "openingHoursSpecification": [{
    "@type":"OpeningHoursSpecification",
    "dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    "opens":"09:00","closes":"20:00"}],
  "areaServed": site.areaServed | cities,
  "sameAs": [site.gis, site.telegram],
  "currenciesAccepted": "RUB",
  "priceRange": "от 15 000 ₽",
  "hasOfferCatalog": {
    "@type":"OfferCatalog","name":"Услуги по ГБО в Златоусте",
    "itemListElement": nav.services | serviceOffers(site)
  }
} | jsonld | safe }}</script>
</head>
<body data-ava="{% if images['avatar-circle-112'] %}/assets/img/avatar-circle-112.png{% endif %}" data-relay="{{ site.relayUrl }}" data-gating="{{ site.reviewGating }}" data-mindelay="{{ site.formMinSeconds }}">
<a class="skip" href="#main">Перейти к содержимому</a>
{% include "partials/icons.njk" %}
{% include "partials/header.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}
{% include "partials/widget.njk" %}
<script src="/assets/js/app.js" defer></script>
{#- Модуль заявок: любая форма с data-lead-form уходит в Worker, чат-виджет
    зовёт window.GBOLeads.send. Адрес Worker'а — data-relay на <body>. -#}
<script src="/assets/js/leads.js" defer></script>
{% if site.metrikaId %}
<script>window.GBO_METRIKA_ID={{ site.metrikaId }};</script>
{% endif %}
</body>
</html>

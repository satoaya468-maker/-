# ИИ-менеджер (Claude API). Без ключа чат работает на правиловом резерве.
ANTHROPIC_API_KEY=

# МойСклад — остатки, цены и резерв под заказ
MOYSKLAD_TOKEN=
MOYSKLAD_STORE_ID=
MOYSKLAD_PRICE_TYPE=Розница

# ЮKassa — онлайн-оплата для физлиц (юрлицам выставляется счёт)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Приёмник лидов: Битрикс24, amoCRM или любой webhook, принимающий JSON
CRM_WEBHOOK_URL=

# Публичный адрес — нужен для return_url оплаты и canonical-ссылок
NEXT_PUBLIC_SITE_URL=https://stroy-sam.ru
